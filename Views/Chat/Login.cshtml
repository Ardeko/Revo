@{
    Layout = null;
    var prefilledCode = ViewBag.PrefilledRoomCode as string;
    var lobbyMode = (ViewBag.LobbyMode as string) ?? (string.IsNullOrWhiteSpace(prefilledCode) ? "public" : "join");
    var isJoin = lobbyMode == "join";
    var isCreate = lobbyMode == "create";
    var isPublic = !isJoin && !isCreate;
    var publicCount = ViewBag.PublicCount is int n ? n : 0;
    var publicNames = (ViewBag.PublicNames as IEnumerable<string>)?.ToList() ?? new List<string>();
    var hasInvite = !string.IsNullOrWhiteSpace(prefilledCode) && prefilledCode.ToUpperInvariant() != "GENEL";
    var peopleLine = string.Join(", ", publicNames);
    if (publicCount > publicNames.Count && publicNames.Count > 0)
        peopleLine += " ve " + (publicCount - publicNames.Count) + " kişi daha";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#11131d" />
    <meta name="description" content="REVO ile arkadaşlarınla aynı odada buluş. Sesli sohbet, mesajlaşma ve ekran paylaşımı." />
    <title>REVO — Birlikte, aynı frekansta</title>
    <link rel="icon" href="~/favicon.ico" />
    <script src="~/js/appearance.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/revo-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/titlebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/revo-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ambient-scene.css" asp-append-version="true" />
</head>
<body class="revo-with-titlebar">
    <div class="revo-titlebar">
        <div class="revo-titlebar__drag">
            <span class="revo-titlebar__logo" aria-hidden="true"></span>
            <span class="revo-titlebar__title">REVO</span>
        </div>
        <div class="revo-titlebar__controls">
            <button type="button" class="revo-titlebar__btn revo-titlebar__btn--minimize" aria-label="Küçült">
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h10" stroke="currentColor" /></svg>
            </button>
            <button type="button" class="revo-titlebar__btn revo-titlebar__btn--maximize" aria-label="Büyüt / Geri yükle">
                <svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="9" height="9" fill="none" stroke="currentColor" /></svg>
            </button>
            <button type="button" class="revo-titlebar__btn revo-titlebar__btn--close" aria-label="Kapat">
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m1 1 10 10M11 1 1 11" stroke="currentColor" stroke-width="1.2" /></svg>
            </button>
        </div>
    </div>

    <div class="login-shell">
        <div class="login-backdrop" data-ambient-scene="eclipse" aria-hidden="true"></div>
        <header class="login-nav">
            <a class="brand" asp-action="Login" asp-controller="Chat" aria-label="REVO ana sayfa">
                <span class="brand__mark" aria-hidden="true"><svg viewBox="0 0 28 28"><path d="M6 18V10m5 12V6m6 14V8m5 9v-6" /></svg></span>
                <span>revo<span class="brand__dot">.</span></span>
            </a>
            <nav class="nav-actions" aria-label="Ana gezinme">
                <a asp-action="Rooms" asp-controller="Chat">Odaları keşfet <span aria-hidden="true">↗</span></a>
                <button type="button" class="nav-create" data-mode-jump="create"><span aria-hidden="true">+</span> Oda oluştur</button>
            </nav>
        </header>

        <main class="login-main">
            <div class="welcome" aria-hidden="true"><span class="welcome__rule"></span><p>Birlikte olmanın sesi.</p><span class="welcome__edition">REVO / HER AN BİRLİKTE</span></div>

            <section class="entry-card" aria-labelledby="entryTitle">
                <div class="entry-heading">
                    <span class="card-kicker">@(hasInvite ? "DAVET EDİLDİN" : "SANA BİR YER VAR")</span>
                    <h1 id="entryTitle">@(hasInvite ? "Ekibine katıl." : "Sohbete katıl.")</h1>
                    <p>Bir isim seç. Gerisi güzel bir sohbet.</p>
                </div>

                <div class="identity">
                    <div class="avatar">
                        <button type="button" class="avatar__btn" id="avatarPreviewBtn" aria-label="Profil fotoğrafı seç" title="Profil fotoğrafı seç">
                            <span id="avatarPreviewInitial">R</span>
                            <img id="avatarPreviewImg" alt="Profil fotoğrafın" hidden />
                            <span class="avatar__edit" aria-hidden="true">+</span>
                        </button>
                        <input type="file" id="avatarFileInput" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
                        <button type="button" class="avatar__clear" id="avatarClearBtn" hidden>Kaldır</button>
                    </div>
                    <div class="field-group" id="usernameGroup">
                        <label for="usernameInput">Sana ne diyelim?</label>
                        <input type="text" id="usernameInput" placeholder="Kullanıcı adın" maxlength="24" autocomplete="nickname" aria-required="true" spellcheck="false" />
                    </div>
                </div>
                <p id="avatarFeedback" class="field-note" role="status" hidden></p>

                <div class="modes" role="tablist" aria-label="Odaya giriş yöntemi">
                    <button type="button" id="publicTab" class="mode-tab @(isPublic ? "active" : "")" data-mode="public" role="tab" aria-controls="publicRoomForm" aria-selected="@(isPublic ? "true" : "false")" tabindex="@(isPublic ? "0" : "-1")">Genel oda</button>
                    <button type="button" id="joinTab" class="mode-tab @(isJoin ? "active" : "")" data-mode="join" role="tab" aria-controls="joinForm" aria-selected="@(isJoin ? "true" : "false")" tabindex="@(isJoin ? "0" : "-1")">Kod ile katıl</button>
                    <button type="button" id="createTab" class="mode-tab @(isCreate ? "active" : "")" data-mode="create" role="tab" aria-controls="createForm" aria-selected="@(isCreate ? "true" : "false")" tabindex="@(isCreate ? "0" : "-1")">Oda oluştur</button>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="form-error" role="alert" tabindex="-1" id="serverError">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }

                <form method="post" asp-action="JoinRoom" asp-controller="Chat" id="publicRoomForm" class="mode-form @(isPublic ? "active" : "")" role="tabpanel" aria-labelledby="publicTab" novalidate>
                    <input type="hidden" name="roomCode" value="GENEL" />
                    <input type="hidden" name="username" id="publicRoomUsername" class="js-username-mirror" />
                    <div class="public-room">
                        <span class="public-room__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m11 5-6 5H2v4h3l6 5V5Zm4 3a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /></svg></span>
                        <div class="public-room__copy"><strong>Açık Frekans</strong><span>Herkese açık, şifre gerektirmez</span></div>
                        <span class="room-count" title="Odadaki kişi sayısı"><span></span>@publicCount</span>
                    </div>
                    <p class="room-presence">@(publicCount == 0 ? "Oda hazır. İlk merhabayı sen söyle." : string.IsNullOrEmpty(peopleLine) ? publicCount + " kişi şu an odada." : peopleLine + " şu an odada.")</p>
                    <button type="submit" class="btn btn--primary" id="publicGo"><span>Sohbete başla</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
                </form>

                <form method="post" asp-action="JoinRoom" asp-controller="Chat" id="joinForm" class="mode-form @(isJoin ? "active" : "")" role="tabpanel" aria-labelledby="joinTab" novalidate>
                    <input type="hidden" name="username" class="js-username-mirror" />
                    <div class="field-group">
                        <label for="roomCodeInput">Oda kodu</label>
                        <input type="text" id="roomCodeInput" name="roomCode" class="code-input" placeholder="Örn. ABC123" required maxlength="8" autocomplete="off" autocapitalize="characters" spellcheck="false" value="@prefilledCode" />
                    </div>
                    <div class="field-group">
                        <label for="joinPasswordInput">Oda şifresi <span>isteğe bağlı</span></label>
                        <input type="password" id="joinPasswordInput" name="password" placeholder="Şifreli bir odaysa gir" maxlength="128" autocomplete="off" />
                    </div>
                    <button type="submit" class="btn btn--primary"><span>Odaya katıl</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
                </form>

                <form method="post" asp-action="CreateRoom" asp-controller="Chat" id="createForm" class="mode-form @(isCreate ? "active" : "")" role="tabpanel" aria-labelledby="createTab" novalidate>
                    <input type="hidden" name="username" class="js-username-mirror" />
                    <p class="create-hint"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="3" /><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" /></svg><span>Kendi alanını oluştur.<small>Oda kodunu arkadaşlarınla paylaşarak davet et.</small></span></p>
                    <div class="field-group">
                        <label for="createPasswordInput">Oda şifresi <span>isteğe bağlı</span></label>
                        <input type="password" id="createPasswordInput" name="password" placeholder="Bir şifre belirle" maxlength="128" autocomplete="new-password" aria-describedby="createPasswordHint" />
                        <p id="createPasswordHint" class="field-hint">Boş bırakırsan kodu olan herkes katılabilir.</p>
                    </div>
                    <button type="submit" class="btn btn--primary"><span>Odamı oluştur</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
                </form>
                <p class="entry-note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v6c0 4-4 7-8 9-4-2-8-5-8-9V6l8-3Z" /><path d="m8 12 3 3 5-6" /></svg>Hesap açmadan, doğrudan sohbete.</p>
            </section>
        </main>

        <footer class="login-footer">
            <span>Ses · Görüntü · Sohbet</span>
            <p>Sesin ve paylaştığın ekran, katıldığın odadakilere iletilir.</p>
            <a href="https://ardekostudios.com/" target="_blank" rel="noopener noreferrer">Ardeko Studios <span aria-hidden="true">↗</span></a>
        </footer>
    </div>
    <script src="~/js/titlebar.js" asp-append-version="true"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
    <script src="~/js/ambient-scene.js" asp-append-version="true"></script>
</body>
</html>
