@{
    Layout = null;
    var prefilledCode = ViewBag.PrefilledRoomCode as string;
    var lobbyMode = (ViewBag.LobbyMode as string) ?? (string.IsNullOrWhiteSpace(prefilledCode) ? "public" : "join");
    var isJoin = lobbyMode == "join";
    var isCreate = lobbyMode == "create";
    var publicCount = ViewBag.PublicCount is int n ? n : 0;
    var publicNames = (ViewBag.PublicNames as IEnumerable<string>)?.ToList() ?? new List<string>();
    var hasInvite = !string.IsNullOrWhiteSpace(prefilledCode) && prefilledCode.ToUpperInvariant() != "GENEL";
    string peopleLine = "";
    string factLine;
    if (publicCount == 0)
    {
        factLine = "Şu an kimse yok · ilk sen gir";
    }
    else
    {
        if (publicNames.Count > 0)
        {
            peopleLine = string.Join(", ", publicNames);
            if (publicCount > publicNames.Count)
                peopleLine += " ve " + (publicCount - publicNames.Count) + " kişi daha";
        }
        else
        {
            peopleLine = publicCount + " kişi";
        }
        factLine = "Şifresiz oda";
    }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>REVO — Giriş</title>
    <link rel="icon" type="image/png" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/revo-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cursor.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/titlebar.css" asp-append-version="true" />
    <style>
        /* ==========================================================
           REVO — Giriş ekranı

           Tam ekran sinematik video + sağa yaslı giriş paneli.
           Palet bilinçli olarak tek renk: siyah zemin, beyaz tipografi,
           yarı saydam beyaz yüzeyler. Yuvarlak köşe, gölge, parıltı yok.

           Photino penceresi chromeless olduğu için üstte 34px'lik kendi
           başlık çubuğumuz duruyor; hero yüksekliği ondan arta kalan
           alana göre hesaplanıyor (--tb-height, titlebar.css içinde
           tanımlı). Tarayıcıda titlebar.js bu değişkeni 0'a çekiyor,
           böylece aynı hesap iki ortamda da doğru sonuç veriyor.

           Fontlar CDN'den değil wwwroot/fonts'tan geliyor (revo-fonts.css)
           — uygulama internetsiz de açılabilmeli.
           ========================================================== */

        :root {
            --bg: #000000;
            --text: #ffffff;
            --text-dim: rgba(255, 255, 255, 0.62);
            --text-dimmer: rgba(255, 255, 255, 0.42);
            --line: rgba(255, 255, 255, 0.14);
            --line-strong: rgba(255, 255, 255, 0.26);
            --fill-ghost: rgba(255, 255, 255, 0.05);
            --fill-solid: rgba(255, 255, 255, 0.10);
            --danger: #C1594A;
            --gutter: clamp(20px, 4.5vw, 88px);
            --ease-premium: cubic-bezier(0.16, 1, 0.3, 1);
            --font-display: 'Sora', 'Helvetica Neue', Helvetica, Arial, sans-serif;
            --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, Consolas, monospace;
        }

        * { box-sizing: border-box; }

        [hidden] { display: none !important; }

        html, body {
            margin: 0;
            padding: 0;
            background: var(--bg);
            color: var(--text);
            font-family: var(--font-display);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow: hidden;
        }

        body { padding-top: var(--tb-height); }

        /* ---------------- Kabuk ---------------- */

        .hero {
            position: relative;
            width: 100%;
            height: calc(100vh - var(--tb-height));
            overflow: hidden;
            display: grid;
            grid-template-rows: auto 1fr auto;
            isolation: isolate;
        }

        .hero__media {
            position: absolute;
            inset: 0;
            z-index: -1;
            background: #000;
        }

        .hero__hole {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            z-index: 0;
            pointer-events: none;
            image-rendering: auto;
        }

        /* Çift katmanlı karartma: yataydaki katman sağa doğru koyulaşıp
           paneli okunur kılıyor, dikeydeki nav ile alt şeridi oturtuyor. */
        .hero__scrim {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background:
                linear-gradient(to right, transparent 0%, transparent 45%, rgba(0,0,0,0.45) 72%, rgba(0,0,0,0.72) 100%),
                linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, transparent 22%, transparent 78%, rgba(0,0,0,0.65) 100%);
        }

        /* ---------------- Üst şerit ---------------- */

        .nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 32px;
            padding: clamp(14px, 1.7vw, 26px) var(--gutter);
        }

        .nav__logo {
            font-family: var(--font-display);
            font-weight: 200;
            font-size: clamp(18px, 1.5vw, 26px);
            letter-spacing: 0.16em;
            line-height: 1;
            color: var(--text);
            text-decoration: none;
        }

        .nav__cluster {
            display: flex;
            align-items: center;
            gap: clamp(24px, 3vw, 56px);
        }

        .nav__links {
            display: flex;
            align-items: center;
            gap: clamp(20px, 2.6vw, 48px);
        }

        .nav__links a,
        .nav__links button {
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: clamp(11px, 0.78vw, 14px);
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text);
            text-decoration: none;
            background: none;
            border: 0;
            padding: 0;
            cursor: pointer;
            transition: color 0.25s ease;
        }

        .nav__links a:hover,
        .nav__links button:hover { color: var(--text-dim); }

        .nav__cta {
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: clamp(11px, 0.78vw, 14px);
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text);
            background: none;
            border: 1px solid var(--line-strong);
            border-radius: 0;
            padding: clamp(10px, 0.85vw, 15px) clamp(18px, 1.6vw, 28px);
            cursor: pointer;
            transition: background 0.25s ease, border-color 0.25s ease;
        }

        .nav__cta:hover {
            background: var(--fill-ghost);
            border-color: rgba(255, 255, 255, 0.5);
        }

        /* ---------------- Panel ---------------- */

        .hero__body {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 0 var(--gutter);
            min-height: 0;
            overflow-y: auto;
        }

        .panel {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            width: min(34vw, 560px);
            min-width: 380px;
        }

        .chip {
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: clamp(11px, 0.72vw, 14px);
            letter-spacing: 0.2em;
            text-transform: uppercase;
            line-height: 1;
            background: rgba(255, 255, 255, 0.09);
            padding: clamp(9px, 0.8vw, 13px) clamp(14px, 1.1vw, 20px);
        }

        .panel__title {
            font-family: var(--font-display);
            font-weight: 200;
            font-size: clamp(44px, 4.6vw, 84px);
            letter-spacing: 0.03em;
            line-height: 0.95;
            margin: clamp(18px, 1.8vw, 34px) 0 0;
        }

        .panel__tagline {
            font-family: var(--font-mono);
            font-weight: 300;
            font-size: clamp(11px, 0.88vw, 15px);
            letter-spacing: 0.14em;
            text-transform: uppercase;
            line-height: 1.4;
            color: var(--text-dim);
            margin: clamp(10px, 1vw, 18px) 0 0;
        }

        /* ---------------- Kimlik: avatar + nick ---------------- */

        .identity {
            display: flex;
            align-items: flex-end;
            gap: 14px;
            width: 100%;
        }

        .identity .field-group {
            flex: 1;
            min-width: 0;
        }

        .avatar {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            flex: none;
        }

        .avatar__btn {
            width: 52px;
            height: 52px;
            flex: none;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--fill-ghost);
            border: 1px solid var(--line-strong);
            border-radius: 0;
            padding: 0;
            overflow: hidden;
            cursor: pointer;
            color: var(--text);
            font-family: var(--font-display);
            font-weight: 300;
            font-size: 20px;
            line-height: 1;
            transition: border-color 0.25s ease, background 0.25s ease;
        }

        .avatar__btn:hover { border-color: rgba(255, 255, 255, 0.5); }

        .avatar__btn img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .avatar__clear {
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: 9px;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--text-dim);
            background: none;
            border: 0;
            padding: 0;
            cursor: pointer;
            text-decoration: underline;
            text-underline-offset: 3px;
            transition: color 0.25s ease;
        }

        .avatar__clear:hover { color: var(--text); }

        /* ---------------- Ana giriş ---------------- */

        .entry {
            width: 100%;
            margin-top: clamp(22px, 2.4vw, 40px);
            display: flex;
            flex-direction: column;
            gap: clamp(16px, 1.6vw, 22px);
        }

        .entry__meta {
            margin: -4px 0 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
        }

        .entry__people,
        .entry__fact {
            margin: 0;
            font-family: var(--font-mono);
            font-weight: 400;
            line-height: 1.45;
        }

        .entry__people {
            font-size: clamp(12px, 0.8vw, 14px);
            letter-spacing: 0.02em;
            color: var(--text-dim);
        }

        .entry__kicker {
            display: inline-block;
            margin-right: 8px;
            font-size: 10px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text-dimmer);
        }

        .entry__fact {
            font-size: clamp(10px, 0.7vw, 12px);
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--text-dimmer);
        }

        .modes-block {
            width: 100%;
            margin-top: clamp(22px, 2.4vw, 40px);
        }

        .modes-kicker {
            display: block;
            margin: 0 0 10px;
            font-family: var(--font-mono);
            font-size: 10px;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--text-dimmer);
        }

        /* ---------------- Sekmeler ---------------- */

        .modes {
            display: flex;
            width: 100%;
            border: 1px solid var(--line);
        }

        .mode-tab {
            flex: 1;
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: clamp(11px, 0.74vw, 13px);
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--text-dimmer);
            background: none;
            border: 0;
            border-radius: 0;
            padding: clamp(11px, 1vw, 16px) 10px;
            cursor: pointer;
            transition: background 0.25s ease, color 0.25s ease;
        }

        .mode-tab + .mode-tab { border-left: 1px solid var(--line); }

        .mode-tab:hover { color: var(--text); }

        .mode-tab.active {
            background: var(--fill-solid);
            color: var(--text);
        }

        /* ---------------- Form ---------------- */

        .form-error {
            width: 100%;
            margin-top: clamp(14px, 1.5vw, 24px);
            padding: 11px 15px;
            border-left: 2px solid var(--danger);
            background: rgba(193, 89, 74, 0.10);
        }

        .form-error p {
            margin: 0;
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: 12px;
            letter-spacing: 0.08em;
            line-height: 1.5;
            color: var(--text);
        }

        .form-error p + p { margin-top: 6px; }

        .mode-form {
            display: none;
            width: 100%;
            flex-direction: column;
            gap: clamp(12px, 1.2vw, 18px);
            margin-top: clamp(16px, 1.6vw, 24px);
        }

        .mode-form.active { display: flex; }

        .field-hint {
            margin: 0;
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: 10px;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--text-dimmer);
        }

        .field-group { position: relative; }

        .field-group input {
            width: 100%;
            background: transparent;
            color: var(--text);
            border: 0;
            border-bottom: 1px solid var(--line-strong);
            border-radius: 0;
            padding: 0 2px clamp(10px, 0.9vw, 15px);
            font-family: var(--font-display);
            font-weight: 300;
            font-size: clamp(15px, 0.95vw, 18px);
            outline: none;
            transition: border-color 0.25s ease;
        }

        .field-group input::placeholder {
            color: var(--text-dim);
            transition: color 0.25s ease;
        }

        .field-group input:focus { border-bottom-color: rgba(255, 255, 255, 0.85); }
        .field-group input:focus::placeholder { color: var(--text-dimmer); }

        /* Oda kodu her zaman büyük harf ve monospace — kod gibi okunsun.
           Sunucu tarafı da kodu ToUpperInvariant ile normalize ettiği için
           (RoomManager.NormalizeCode) bu sadece görsel bir dokunuş. */
        .field-group input.code-input {
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: clamp(14px, 0.88vw, 16px);
            letter-spacing: 0.22em;
            text-transform: uppercase;
        }

        .field-group input.code-input::placeholder {
            letter-spacing: 0.22em;
            text-transform: uppercase;
        }

        /* WebView2 otomatik doldurmada alanı beyaza boyuyor; iç gölge
           hilesiyle zemini siyah tutuyoruz. */
        .field-group input:-webkit-autofill,
        .field-group input:-webkit-autofill:hover,
        .field-group input:-webkit-autofill:focus {
            -webkit-text-fill-color: var(--text);
            -webkit-box-shadow: 0 0 0 1000px #000 inset;
            transition: background-color 5000s ease-in-out 0s;
        }

        .field-group.is-invalid input { border-bottom-color: var(--danger); }

        .field-note {
            margin: 8px 0 0;
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: 11px;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--danger);
            animation: note-in 0.3s var(--ease-premium);
        }

        @@keyframes note-in {
            from { opacity: 0; transform: translateY(-4px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ---------------- Butonlar ---------------- */

        .btn {
            width: 100%;
            display: block;
            text-align: center;
            border: 0;
            border-radius: 0;
            padding: clamp(14px, 1.35vw, 22px) 20px;
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: clamp(11px, 0.78vw, 14px);
            letter-spacing: 0.22em;
            text-transform: uppercase;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.25s ease, color 0.25s ease;
        }

        .btn--solid {
            background: var(--fill-solid);
            color: var(--text);
        }

        .btn--solid:hover { background: rgba(255, 255, 255, 0.17); }

        .btn--primary {
            background: #fff;
            color: #000;
        }

        .btn--primary:hover { background: rgba(255, 255, 255, 0.86); }

        .btn--ghost {
            background: var(--fill-ghost);
            color: var(--text-dimmer);
            margin-top: clamp(10px, 1vw, 16px);
        }

        .btn--ghost:hover {
            background: rgba(255, 255, 255, 0.09);
            color: var(--text);
        }

        .panel__alt {
            align-self: center;
            margin-top: clamp(16px, 1.8vw, 30px);
            font-family: var(--font-mono);
            font-weight: 400;
            font-size: clamp(11px, 0.74vw, 14px);
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text);
            text-decoration: none;
            transition: color 0.25s ease;
        }

        .panel__alt:hover {
            color: var(--text-dim);
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        /* ---------------- Alt şerit ---------------- */

        .legal {
            border-top: 1px solid var(--line);
            padding: clamp(12px, 1.3vw, 22px) var(--gutter);
            text-align: center;
        }

        .legal__text {
            margin: 0;
            font-family: var(--font-display);
            font-weight: 300;
            font-size: clamp(11px, 0.76vw, 14px);
            line-height: 1.5;
            color: var(--text-dim);
        }

        .legal__text a {
            color: var(--text);
            text-decoration: underline;
            text-underline-offset: 3px;
            text-decoration-thickness: 1px;
            transition: color 0.25s ease;
        }

        .legal__text a:hover { color: var(--text-dim); }

        /* ---------------- Odak ---------------- */

        .nav__logo:focus-visible,
        .nav__links a:focus-visible,
        .nav__links button:focus-visible,
        .nav__cta:focus-visible,
        .avatar__btn:focus-visible,
        .avatar__clear:focus-visible,
        .mode-tab:focus-visible,
        .btn:focus-visible,
        .panel__alt:focus-visible,
        .legal__text a:focus-visible {
            outline: 1px solid rgba(255, 255, 255, 0.7);
            outline-offset: 3px;
        }

        /* Alanlarda kutu şeklinde bir odak halkası alt çizgi estetiğini
           bozuyor; odak zaten alt çizginin beyazlamasıyla belli oluyor. */
        .field-group input:focus-visible { outline: none; }

        /* ---------------- Duyarlılık ----------------
           Mobil hamburger menü bilerek yok: bu ekran 1320x860'lık sabit bir
           masaüstü penceresinde açılıyor. Yine de pencere küçültülürse
           panel ortalanıp genişliyor. */

        @@media (max-width: 1100px) {
            .panel {
                width: min(70vw, 520px);
                min-width: 0;
            }
        }

        @@media (max-width: 820px) {
            .hero__scrim {
                background: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.25) 30%, rgba(0,0,0,0.75) 100%);
            }

            .hero__body { justify-content: center; }

            .panel {
                width: 100%;
                align-items: stretch;
            }

            .chip { align-self: flex-start; }
            .nav__links { gap: 20px; }
        }

        @@media (max-width: 560px) {
            .nav__links { display: none; }
            .panel__title { font-size: clamp(40px, 13vw, 60px); }
        }

        /* Alçak pencere: panelin kaymaması için her şey biraz sıkışıyor. */
        @@media (max-height: 720px) {
            .panel__title { font-size: clamp(34px, 3.6vw, 52px); }
            .panel__tagline { margin-top: 8px; }
            .avatar__btn { width: 44px; height: 44px; font-size: 17px; }
            .entry { margin-top: 16px; gap: 12px; }
            .modes-block { margin-top: 16px; }
            .mode-tab { padding: 10px; }
            .mode-form { margin-top: 12px; gap: 10px; }
            .btn { padding: 12px 20px; }
            .btn--ghost { margin-top: 8px; }
            .panel__alt { margin-top: 14px; }
            .nav { padding: 10px var(--gutter); }
            .legal { padding: 10px var(--gutter); }
            .legal__text { font-size: 11px; }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body class="revo-with-titlebar">
    <div class="revo-titlebar">
        <div class="revo-titlebar__drag">
            <span class="revo-titlebar__logo" aria-hidden="true"></span>
            <span class="revo-titlebar__title">REVO</span>
        </div>
        <div class="revo-titlebar__controls">
            <button type="button" class="revo-titlebar__btn revo-titlebar__btn--minimize" aria-label="Küçült">
                <svg viewBox="0 0 12 12"><rect x="1" y="5.5" width="10" height="1" fill="currentColor" /></svg>
            </button>
            <button type="button" class="revo-titlebar__btn revo-titlebar__btn--maximize" aria-label="Büyüt / Geri Yükle">
                <svg viewBox="0 0 12 12"><rect x="1.5" y="1.5" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1" /></svg>
            </button>
            <button type="button" class="revo-titlebar__btn revo-titlebar__btn--close" aria-label="Kapat">
                <svg viewBox="0 0 12 12">
                    <line x1="1" y1="1" x2="11" y2="11" stroke="currentColor" stroke-width="1.2" />
                    <line x1="11" y1="1" x2="1" y2="11" stroke="currentColor" stroke-width="1.2" />
                </svg>
            </button>
        </div>
    </div>

    <section class="hero">
        <div class="hero__media" id="loginBlackhole" aria-hidden="true">
            <div class="hero__scrim"></div>
        </div>

        <header class="nav">
            <a class="nav__logo" asp-action="Login" asp-controller="Chat">REVO</a>
            <div class="nav__cluster">
                <div class="nav__links">
                    <a asp-action="Rooms" asp-controller="Chat">Aktif odalar</a>
                </div>
                <button type="button" class="nav__cta" data-mode-jump="create">Oda kur</button>
            </div>
        </header>

        <div class="hero__body">
            <div class="panel">
                <span class="chip">@(hasInvite ? "[ Davet ]" : "[ Lobi ]")</span>

                <h1 class="panel__title">REVO</h1>

                <p class="panel__tagline">@(hasInvite ? "Nickini yaz, davet koduna gir." : "Nickini yaz, açık frekansa gir.")</p>

                <div class="entry">
                    <div class="identity">
                        <div class="avatar">
                            <button type="button" class="avatar__btn" id="avatarPreviewBtn" aria-label="Profil resmi seç">
                                <span id="avatarPreviewInitial">?</span>
                                <img id="avatarPreviewImg" alt="" hidden />
                            </button>
                            <input type="file" id="avatarFileInput" accept="image/*" hidden />
                            <button type="button" class="avatar__clear" id="avatarClearBtn" hidden>Kaldır</button>
                        </div>
                        <div class="field-group" id="usernameGroup">
                            <input type="text" id="usernameInput" placeholder="Nickini yaz…" maxlength="24" autocomplete="nickname" />
                        </div>
                    </div>

                    <form method="post" asp-action="JoinRoom" asp-controller="Chat" id="publicRoomForm" novalidate>
                        <input type="hidden" name="roomCode" value="GENEL" />
                        <input type="hidden" name="username" id="publicRoomUsername" class="js-username-mirror" />
                        <button type="submit" class="btn @(hasInvite ? "btn--ghost" : "btn--primary")" id="publicGo">Açık Frekansa gir</button>
                    </form>
                    <div class="entry__meta">
                        @if (!string.IsNullOrEmpty(peopleLine))
                        {
                            <p class="entry__people"><span class="entry__kicker">İçeride</span>@peopleLine</p>
                        }
                        <p class="entry__fact">@factLine</p>
                    </div>
                </div>

                <div class="modes-block">
                    <span class="modes-kicker">Başka bir oda</span>
                    <div class="modes" role="tablist">
                        <button type="button" class="mode-tab @(isJoin ? "active" : "")" data-mode="join" role="tab" aria-selected="@(isJoin ? "true" : "false")">Odaya katıl</button>
                        <button type="button" class="mode-tab @(isCreate ? "active" : "")" data-mode="create" role="tab" aria-selected="@(isCreate ? "true" : "false")">Oda kur</button>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="form-error">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }

                <form method="post" asp-action="JoinRoom" asp-controller="Chat" id="joinForm" class="mode-form @(isJoin ? "active" : "")" novalidate>
                    <input type="hidden" name="username" class="js-username-mirror" />
                    <div class="field-group">
                        <input type="text" name="roomCode" class="code-input" placeholder="Oda kodu" required maxlength="8" autocomplete="off" value="@prefilledCode" />
                    </div>
                    <div class="field-group">
                        <input type="password" name="password" placeholder="Şifre (varsa)" autocomplete="off" />
                    </div>
                    <button type="submit" class="btn btn--solid">Odaya gir</button>
                </form>

                <form method="post" asp-action="CreateRoom" asp-controller="Chat" id="createForm" class="mode-form @(isCreate ? "active" : "")" novalidate>
                    <input type="hidden" name="username" class="js-username-mirror" />
                    <p class="field-hint">Kod senin için üretilir</p>
                    <div class="field-group">
                        <input type="password" name="password" placeholder="Şifre koy (opsiyonel)" autocomplete="off" />
                    </div>
                    <button type="submit" class="btn btn--solid">Oda kur</button>
                </form>
            </div>
        </div>

        <footer class="legal">
            <p class="legal__text">
                Bir odaya girdiğinde sesin ve paylaştığın ekran odadaki herkese iletilir.
                <a href="https://ardekostudios.com/" target="_blank" rel="noopener noreferrer" onclick="window.open(this.href, '_blank'); return false;">Ardeko Studios</a> yapımı.
            </p>
        </footer>
    </section>

    <script src="~/js/cursor.js" asp-append-version="true"></script>
    <script src="~/js/titlebar.js" asp-append-version="true"></script>
    <script src="~/js/blackhole-hero.js" asp-append-version="true"></script>
    <script src="~/js/blackhole-scene.js" asp-append-version="true"></script>
    <script>
        if (window.RevoBlackhole) {
            window.RevoBlackhole.mount(document.getElementById("loginBlackhole"), {
                focus: [0.34, 0.46],
                scrim: "right",
                scrimStrength: 0.78,
                starBrightness: 0,
                glow: 0,
                skipBloom: true,
                steps: 52,
                resolution: 0.28,
                maxDpr: 1,
                hotColor: "#F5F9FC",
                midColor: "#8FB9D6",
                coolColor: "#2C4254",
                doppler: 0.16,
                brightness: 1.14,
                exposure: 1.0
            });
        }
    </script>
    <script>
        (function () {
            "use strict";

            var USERNAME_KEY = "revo_username";
            var forms = {
                join: document.getElementById("joinForm"),
                create: document.getElementById("createForm")
            };
            var publicForm = document.getElementById("publicRoomForm");
            var usernameInput = document.getElementById("usernameInput");
            var usernameGroup = document.getElementById("usernameGroup");
            var tabs = Array.prototype.slice.call(document.querySelectorAll(".mode-tab"));
            var currentMode = document.querySelector(".mode-tab.active")
                ? document.querySelector(".mode-tab.active").dataset.mode
                : "public";

            var FIELD_MESSAGES = {
                username: "Bir nick yaz",
                roomCode: "Oda kodunu gir"
            };

            function clearFieldError(group) {
                if (!group) return;
                group.classList.remove("is-invalid");
                var note = group.querySelector(".field-note");
                if (note) note.remove();
            }

            function showFieldError(input, message) {
                var group = input.closest(".field-group") || usernameGroup;
                if (!group) return;
                clearFieldError(group);
                void group.offsetWidth;
                group.classList.add("is-invalid");
                var note = document.createElement("p");
                note.className = "field-note";
                note.textContent = message;
                group.appendChild(note);
            }

            function usernameValue() {
                return (usernameInput.value || "").trim();
            }

            function mirrorUsername() {
                var name = usernameValue();
                document.querySelectorAll(".js-username-mirror").forEach(function (el) {
                    el.value = name;
                });
                try {
                    if (name) localStorage.setItem(USERNAME_KEY, name);
                } catch (err) { /* gizli tarama */ }
            }

            function requireUsername() {
                var name = usernameValue();
                if (name) {
                    clearFieldError(usernameGroup);
                    mirrorUsername();
                    return true;
                }
                showFieldError(usernameInput, FIELD_MESSAGES.username);
                usernameInput.focus();
                return false;
            }

            function validateForm(form) {
                if (!requireUsername()) return false;
                var firstInvalid = null;
                form.querySelectorAll("input[required]").forEach(function (input) {
                    if (input.value.trim()) {
                        clearFieldError(input.closest(".field-group"));
                        return;
                    }
                    showFieldError(input, FIELD_MESSAGES[input.name] || "Bu alan gerekli");
                    if (!firstInvalid) firstInvalid = input;
                });
                if (firstInvalid) firstInvalid.focus();
                return !firstInvalid;
            }

            usernameInput.addEventListener("input", function () {
                if (usernameValue()) clearFieldError(usernameGroup);
                updateAvatarFromName();
            });

            document.querySelectorAll(".mode-form input").forEach(function (input) {
                input.addEventListener("input", function () {
                    if (input.value.trim()) clearFieldError(input.closest(".field-group"));
                });
            });

            publicForm.addEventListener("submit", function (e) {
                if (!requireUsername()) e.preventDefault();
            });

            Object.keys(forms).forEach(function (mode) {
                forms[mode].addEventListener("submit", function (e) {
                    if (!validateForm(forms[mode])) e.preventDefault();
                });
            });

            usernameInput.addEventListener("keydown", function (e) {
                if (e.key !== "Enter") return;
                e.preventDefault();
                publicForm.requestSubmit();
            });

            function setMode(mode, options) {
                var allowToggle = !options || options.toggle !== false;

                if (mode !== "join" && mode !== "create") {
                    currentMode = "public";
                    tabs.forEach(function (t) {
                        t.classList.remove("active");
                        t.setAttribute("aria-selected", "false");
                    });
                    Object.keys(forms).forEach(function (m) {
                        forms[m].classList.remove("active");
                        forms[m].querySelectorAll(".field-group").forEach(clearFieldError);
                    });
                    usernameInput.focus();
                    return;
                }

                if (allowToggle && currentMode === mode) {
                    setMode("public");
                    return;
                }

                currentMode = mode;
                tabs.forEach(function (t) {
                    var on = t.dataset.mode === mode;
                    t.classList.toggle("active", on);
                    t.setAttribute("aria-selected", on ? "true" : "false");
                });
                Object.keys(forms).forEach(function (m) {
                    forms[m].classList.toggle("active", m === mode);
                    forms[m].querySelectorAll(".field-group").forEach(clearFieldError);
                });
                var firstVisible = forms[mode].querySelector("input:not([type='hidden'])");
                if (firstVisible) firstVisible.focus();
            }

            tabs.forEach(function (tab) {
                tab.addEventListener("click", function () { setMode(tab.dataset.mode); });
            });

            document.querySelectorAll("[data-mode-jump]").forEach(function (el) {
                el.addEventListener("click", function () {
                    setMode(el.dataset.modeJump, { toggle: false });
                });
            });

            try {
                var saved = localStorage.getItem(USERNAME_KEY);
                if (saved && !usernameInput.value) usernameInput.value = saved;
            } catch (err) { /* */ }

            if (currentMode === "join") {
                var codeInput = forms.join.querySelector("input[name='roomCode']");
                if (codeInput && codeInput.value) {
                    var pw = forms.join.querySelector("input[name='password']");
                    if (pw) pw.focus();
                    else codeInput.focus();
                } else usernameInput.focus();
            } else if (currentMode === "create") {
                var createPw = forms.create.querySelector("input[name='password']");
                if (createPw) createPw.focus();
                else usernameInput.focus();
            } else {
                usernameInput.focus();
            }

            var avatarPreviewBtn = document.getElementById("avatarPreviewBtn");
            var avatarPreviewImg = document.getElementById("avatarPreviewImg");
            var avatarPreviewInitial = document.getElementById("avatarPreviewInitial");
            var avatarFileInput = document.getElementById("avatarFileInput");
            var avatarClearBtn = document.getElementById("avatarClearBtn");

            function updateAvatarFromName() {
                if (sessionStorage.getItem("revoAvatar")) return;
                var name = usernameValue();
                avatarPreviewInitial.textContent = name ? name.charAt(0).toLocaleUpperCase("tr-TR") : "?";
                avatarPreviewBtn.style.background = name ? "rgba(255,255,255,0.10)" : "";
                avatarPreviewBtn.style.color = "";
            }

            var existingAvatar = sessionStorage.getItem("revoAvatar");
            if (existingAvatar) {
                avatarPreviewImg.src = existingAvatar;
                avatarPreviewImg.hidden = false;
                avatarPreviewInitial.hidden = true;
                avatarClearBtn.hidden = false;
            } else {
                updateAvatarFromName();
            }

            avatarPreviewBtn.addEventListener("click", function () { avatarFileInput.click(); });

            avatarFileInput.addEventListener("change", function () {
                var file = avatarFileInput.files[0];
                if (!file) return;
                var reader = new FileReader();
                reader.onload = function (e) {
                    var img = new Image();
                    img.onload = function () {
                        var SIZE = 128;
                        var canvas = document.createElement("canvas");
                        canvas.width = SIZE;
                        canvas.height = SIZE;
                        var ctx = canvas.getContext("2d");
                        var side = Math.min(img.width, img.height);
                        var sx = (img.width - side) / 2;
                        var sy = (img.height - side) / 2;
                        ctx.drawImage(img, sx, sy, side, side, 0, 0, SIZE, SIZE);
                        var dataUrl = canvas.toDataURL("image/jpeg", 0.72);
                        sessionStorage.setItem("revoAvatar", dataUrl);
                        avatarPreviewImg.src = dataUrl;
                        avatarPreviewImg.hidden = false;
                        avatarPreviewInitial.hidden = true;
                        avatarClearBtn.hidden = false;
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });

            avatarClearBtn.addEventListener("click", function () {
                sessionStorage.removeItem("revoAvatar");
                avatarFileInput.value = "";
                avatarPreviewImg.hidden = true;
                avatarPreviewInitial.hidden = false;
                avatarClearBtn.hidden = true;
                avatarPreviewBtn.style.background = "";
                avatarPreviewBtn.style.color = "";
                updateAvatarFromName();
            });
        })();
    </script>
</body>
</html>
